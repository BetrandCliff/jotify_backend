APP_NAME=Planner API
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Copy your Neon connection string here. Keep this secret out of Flutter builds.
NEON_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
MAX_UPLOAD_BYTES=20971520

# Required only for reading old profiles/notes/recordings and first legacy sign-in.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, for new profile images and audio recordings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom domain for public objects. If empty, the API issues signed read URLs.
R2_PUBLIC_BASE_URL=

# Configure an SMTP provider before production to send verification/reset codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Planner
SMTP_USE_TLS=true

# Optional Google OAuth client ID. Google sign-in is disabled if empty.
GOOGLE_CLIENT_ID=